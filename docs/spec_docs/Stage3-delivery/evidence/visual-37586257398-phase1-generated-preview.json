    {
      "scenarioId": "custom-1",
      "worldName": "石灯镇",
      "worldDescription": "石灯镇是一座被一条笔直鹅卵石路贯穿南北的宁静小镇，路的两旁是低矮的老屋与零星店铺。小镇气候温和，四季分明，居民们彼此熟识，生活节奏缓慢而踏实。这里的人们习惯在傍晚聚集到北端的小广场，有人在咖啡馆里消磨午后，有人守着住宅二楼的窗台看街景。镇上流传着关于广场中央那盏石灯来历的模糊传说，至今无人能说清它的真正年代。",
      "locations": [
        {
          "name": "鹅卵石路",
          "description": "一条笔直的鹅卵石路从南到北穿过小镇，是居民往来的主要通道。"
        },
        {
          "name": "旧时光咖啡馆",
          "description": "位于鹅卵石路旁的小咖啡馆，几张木桌、一墙旧书，是闲聊和独处的好去处。"
        },
        {
          "name": "两层住宅",
          "description": "紧邻咖啡馆的一栋两层老住宅，一楼是客厅与厨房，二楼住着房东或租客。"
        },
        {
          "name": "石灯广场",
          "description": "鹅卵石路北端的小广场，铺着同样的石块，白天有人摆摊，夜晚常有居民散步。"
        },
        {
          "name": "中央石灯",
          "description": "广场正中央立着一盏古老石灯，灯身刻有模糊纹路，入夜后仍有人为它点灯。"
        },
        {
          "name": "南口杂货铺",
          "description": "鹅卵石路南端的小铺子，卖日用杂货和当地特产，也是消息集散地。"
        },
        {
          "name": "镇西小教堂",
          "description": "一座简朴的老教堂，周末有礼拜，平时安静，偶尔举办社区活动。"
        },
        {
          "name": "东侧河岸步道",
          "description": "沿镇东小河铺设的步道，可以钓鱼、慢跑或坐在长椅上发呆。"
        }
      ],
