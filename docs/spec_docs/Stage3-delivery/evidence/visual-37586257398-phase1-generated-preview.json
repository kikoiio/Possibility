    {
      "scenarioId": "custom-2",
      "worldName": "广场街",
      "worldDescription": "广场街紧邻小镇中央的钟楼广场，是镇上最热闹又最安静的一条街。石板路两侧排着老梧桐，风一吹就有叶子落在咖啡馆门前。街上住着几户老邻居，也租给过路的年轻人，谁家的灯亮着，谁家今天没拉开窗帘，街坊心里都有数。咖啡馆是这条街的心脏，人们在这里交换消息、消磨下午，有时也把心事说给不该听的人。",
      "locations": [
        {
          "name": "广场街",
          "description": "一条挨着广场的石板小街，两边是店铺和住家，街口正对钟楼。"
        },
        {
          "name": "钟楼广场",
          "description": "小镇中心的卵石广场，钟楼每小时敲一次，人们在这里等车、闲聊、喂鸽子。"
        },
        {
          "name": "梧桐咖啡馆",
          "description": "广场街上唯一的咖啡馆，木门铜铃，靠窗的位置能看到整条街和广场一角。"
        },
        {
          "name": "街角杂货铺",
          "description": "街尾的小铺子，卖日用杂货和当天面包，老板认识街上的每一个人。"
        },
        {
          "name": "沿河小径",
          "description": "广场街尽头拐向河边的小路，晨跑和晚饭后散步的人都走这里。"
        },
        {
          "name": "旧公寓楼",
          "description": "街中段一栋四层砖楼，住着几户长租客，楼道里贴着褪色的水电通知。"
        },
        {
          "name": "社区公告栏",
          "description": "咖啡馆对面墙上的木框布告板，贴着集市、招租和寻物启事。"
        }
      ],
