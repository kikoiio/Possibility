# Copy to .env in the repository root. Do not commit your actual .env.
# Required: use your provider's Responses base URL (e.g. https://api.example.com/v1)
# or its complete /responses endpoint, model ID, and API key.
WISPIVA_LLM_BASE_URL=
WISPIVA_LLM_MODEL=
WISPIVA_LLM_API_KEY=

# Optional, only if your provider supports it; unset uses its default.
# WISPIVA_LLM_REASONING_EFFORT=

# Requests stream with no application total timeout or max_output_tokens setting.
# Provider limits still apply; users can cancel an active request.
