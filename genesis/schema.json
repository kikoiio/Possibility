{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wispiva.invalid/genesis/v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
    },
    "places": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
          }
        },
        "required": [
          "id",
          "name",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
          },
          "placeId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          }
        },
        "required": [
          "id",
          "name",
          "role",
          "goal",
          "placeId"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 16
    },
    "memories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "actorId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
          }
        },
        "required": [
          "actorId",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f]+$"
          }
        },
        "required": [
          "id",
          "description"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 32
    },
    "layout": {
      "type": "object",
      "properties": {
        "places": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "placeId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,39}$"
              },
              "space": {
                "enum": [
                  "indoor",
                  "outdoor"
                ]
              },
              "grid": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": -100,
                    "maximum": 100
                  },
                  {
                    "type": "integer",
                    "minimum": -100,
                    "maximum": 100
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "placeId",
              "space",
              "grid"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 16
        },
        "connections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,39}$"
              },
              "to": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,39}$"
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 64
        }
      },
      "required": [
        "places",
        "connections"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "title",
    "description",
    "places",
    "actors",
    "memories",
    "rules",
    "layout"
  ],
  "additionalProperties": false
}
