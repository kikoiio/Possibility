{
  "name": "wispiva",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/contract/tsconfig.json --noEmit",
    "wispiva": "npm run build --workspace=@wispiva/web && npm run start --workspace=@wispiva/engine --"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "ajv": "^8.17.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
