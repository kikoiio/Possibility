{
  "name": "virtual-neighbor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:scheduled": "wrangler dev --test-scheduled",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "build:web": "vite build web",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "deploy:demo": "wrangler deploy --env demo",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.31",
    "ai": "^7.0.77",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260823.1",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
