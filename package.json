{
  "name": "possibility",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "web",
    "api"
  ],
  "scripts": {
    "dev": "concurrently -n web,api,engine -c blue,magenta,green \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:engine\"",
    "dev:web": "npm --workspace web run dev",
    "dev:api": "npm --workspace api run dev",
    "dev:engine": "tsx scripts/engine-pinger.ts",
    "db:migrate": "npm --workspace api run db:migrate",
    "seed": "tsx scripts/seed.ts",
    "migrate:p2": "tsx scripts/migrate-p2.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "verify:s01:legacy": "node --import tsx scripts/verify-s01-legacy.ts",
    "verify:s01:workers": "node --experimental-strip-types scripts/verify-s01-workers.ts",
    "verify:s01:remote-workers": "node --experimental-strip-types scripts/verify-s01-remote-workers.ts",
    "apply:s01:remote-test-migrations": "node --experimental-strip-types scripts/apply-s01-remote-migrations.ts",
    "verify:s01:remote-journey": "node --experimental-strip-types scripts/verify-s01-remote-journey.ts",
    "verify:s01:live-model": "tsx scripts/verify-s01-live-model.ts",
    "verify:s03:migrations": "node --experimental-strip-types scripts/verify-s03-migration.ts",
    "verify:s01:live-journey": "node --import tsx scripts/verify-s01-live-journey.ts",
    "verify:s01:live-closure": "node --import tsx scripts/verify-s01-live-closure.ts",
    "verify:s02": "npm --workspace @possibility/scene-contract test && npm --workspace @possibility/scene-contract run build && npm --workspace api test && npm --workspace api run build && npm --workspace web test && npm --workspace web run build && npm --workspace web run test:e2e",
    "asset:import": "tsx scripts/asset-import.ts",
    "asset:thumbnail": "node scripts/asset-thumbnail.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12"
  }
}
