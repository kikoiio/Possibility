{
  // 虚拟邻居 — Cloudflare Worker 配置
  "name": "virtual-neighbor",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // 当前状态：静态存档（无 cron，世界冻结，内容可读，零 LLM 费用）。
  // 恢复运转：把 triggers 加回（"crons": ["*/30 * * * *"]）再 deploy 即可，
  // 世界会从快照无缝续跑。

  // 信息流前端静态资源（vite build 产物）
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      // 故事数据所在库（即 demo 库：8 章故事、谜团、记忆都在此）
      "database_name": "virtual-neighbor-demo",
      "database_id": "fe92786e-f672-46b7-a301-b49de1f442c9",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "7dfca069fe864c569f654a15358d9144"
    }
  ],

  // 演示环境：独立 D1 + 独立 KV + 加密心跳（5 分钟），不对外的预览域名
  "env": {
    "demo": {
      "name": "virtual-neighbor-demo",
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "virtual-neighbor-demo",
          "database_id": "fe92786e-f672-46b7-a301-b49de1f442c9",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CONFIG_KV",
          "id": "7dfca069fe864c569f654a15358d9144"
        }
      ]
    }
  }
}
