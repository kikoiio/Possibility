{
  // 虚拟邻居 — Cloudflare Worker 配置
  "name": "virtual-neighbor",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // 世界心跳：每 30 分钟一个 tick（休眠窗口在 tick 内判断 no-op）
  "triggers": {
    "crons": ["*/30 * * * *"]
  },

  // 信息流前端静态资源（vite build 产物）
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "virtual-neighbor",
      "database_id": "80e0156f-5568-4678-a9d0-31523f33af46",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "1636e7c93dab4dc8bcda5977ff042713"
    }
  ],

  // 演示环境：独立 D1 + 独立 KV + 加密心跳（5 分钟），不对外的预览域名
  "env": {
    "demo": {
      "name": "virtual-neighbor-demo",
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "virtual-neighbor-demo",
          "database_id": "fe92786e-f672-46b7-a301-b49de1f442c9",
          "migrations_dir": "migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CONFIG_KV",
          "id": "7dfca069fe864c569f654a15358d9144"
        }
      ]
    }
  }
}
